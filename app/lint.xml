<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- AAPT2 requires the -v26 qualifier for <adaptive-icon> resources even
         though minSdk is 29; lint's suggestion to drop it does not link. -->
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>
    <!-- bouncycastle comes with pdfbox-android for PDF signatures; the app never uses it for TLS. -->
    <!-- The universal release APK is for phones: ML Kit's OCR library costs ~11 MB per ABI, so the
         x86 ABIs are left out (ARM Chromebooks still run the app). -->
    <issue id="ChromeOsAbiSupport" severity="ignore" />
    <issue id="TrustAllX509TrustManager">
        <ignore regexp="bcpkix-jdk15to18" />
    </issue>
</lint>
